# LLM (langchain init_chat_model — provider-agnostic). 모델 ID는 코드에 하드코딩하지 않는다.
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-5-mini     # B·C 및 별도 오버라이드가 없는 에이전트의 기본값
JUDGE_MODEL=gpt-5-mini   # 실효 보고서 모델(LLM_MODEL_REPORT 폴백 LLM_MODEL)과 달라야 함
# 에이전트별 모델 (선택). 비우면 LLM_MODEL 폴백. 실행 후 B 인용 폐기율·C not_public 비율·D judge 점수를 보고 채운다.
LLM_MODEL_TECH_RESEARCH=
LLM_MODEL_DOMAIN=
LLM_MODEL_MARKET=
LLM_MODEL_STAKEHOLDER=
LLM_MODEL_SYNTHESIS=gpt-5-mini
LLM_MODEL_REPORT=gpt-4o
# 주의: 어떤 모델이든 with_structured_output 이 네이티브 tool calling 으로 동작하는 provider 여야 한다.

# Retrieval (A)
EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_DIR=data/chroma
PAPERS_DIR=data/papers

# Web Search (C)
WEB_SEARCH_PROVIDER=     # C가 확정 (tavily / serper / 등)
WEB_SEARCH_API_KEY=

# 출력
OUTPUT_DIR=outputs
LOG_LEVEL=INFO
