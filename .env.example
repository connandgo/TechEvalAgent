# LLM (langchain init_chat_model — provider-agnostic). 모델 ID는 코드에 하드코딩하지 않는다.
LLM_PROVIDER=            # 팀 합의로 확정 (예: anthropic / openai / google_genai)
LLM_MODEL=               # 평가·생성용
JUDGE_MODEL=             # 보고서 검수용 — LLM_MODEL과 달라야 함 (같으면 시작 시 경고)

# Retrieval (A)
EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_DIR=data/chroma
PAPERS_DIR=data/papers

# Web Search (C)
WEB_SEARCH_PROVIDER=     # C가 확정 (tavily / serper / 등)
WEB_SEARCH_API_KEY=

# 출력
OUTPUT_DIR=outputs
LOG_LEVEL=INFO
